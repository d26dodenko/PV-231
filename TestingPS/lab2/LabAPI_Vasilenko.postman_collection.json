      "name": "Auth",
      "item": [
        {
          "name": "TC-AUTH-01 — Получить токен",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth",
            "description": "**Цель:** Получить токен для защищённых запросов\n\n**Входные данные:** admin / password123\n\n**Ожидаемый результат:** 200 OK и непустой token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP: ожидается 200\", () => { pm.response.to.have.status(200); });",
                  "pm.test(\"Время ответа менее 5000 мс\", () => { pm.expect(pm.response.responseTime).to.be.below(5000); });",
                  "pm.test(\"Ответ соответствует сценарию\", () => { const obj = pm.response.json(); pm.expect(obj.token).to.be.a(\"string\").and.not.empty; });",
                  "pm.test(\"Токен сохранён в окружение\", () => { const token = pm.response.json().token; pm.environment.set(\"token\", token); pm.expect(pm.environment.get(\"token\")).to.equal(token); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-AUTH-02 — Неверный пароль",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth",
            "description": "**Цель:** Проверить отказ при неправильной аутентификации\n\n**Входные данные:** admin / incorrect_password\n\n**Ожидаемый результат:** 401 Unauthorized (REST-ожидание; сервис может вернуть 200).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"incorrect_password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP: ожидается 401\", () => { pm.response.to.have.status(401); });",
                  "pm.test(\"Время ответа менее 5000 мс\", () => { pm.expect(pm.response.responseTime).to.be.below(5000); });",
                  "pm.test(\"Ответ соответствует сценарию\", () => { pm.expect(pm.response.json()).to.have.property(\"reason\"); });",
                  "pm.test(\"Запрос отклонён HTTP-кодом\", () => { pm.expect(pm.response.code).to.be.at.least(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
