                      "pm.test(\"Время ответа менее 5000 мс\", () => { pm.expect(pm.response.responseTime).to.be.below(5000); });",
                      "pm.test(\"Ответ соответствует сценарию\", () => { const obj = pm.response.json(); pm.expect(obj.bookingid).to.be.a(\"number\"); pm.expect(obj.booking.firstname).to.equal(\"Ilya\"); });",
                      "pm.test(\"bookingId сохранён\", () => { const id = pm.response.json().bookingid; pm.environment.set(\"bookingId\", String(id)); pm.expect(pm.environment.get(\"bookingId\")).to.equal(String(id)); });"
