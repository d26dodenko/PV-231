                  "raw": "{\n  \"firstname\": \"Ilya\",\n  \"lastname\": \"Vasilenko\",\n  \"totalprice\": 180,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-10\",\n    \"checkout\": \"2026-11-12\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
